---
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Course Overview", href: "/course-overview" },
	{ label: "Pricing & Enroll", href: "/pricing" },
	{ label: "FAQ", href: "/faq" },
	{ label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="relative z-50 border-b border-gold-500/40 bg-navy-900">
	<div
		class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8"
	>
		<Logo class="h-20" />

		<nav
			aria-label="Primary"
			class="hidden items-center gap-8 lg:flex"
		>
			<ul class="flex items-center gap-7">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? "page" : undefined}
								class={`font-heading text-sm font-bold tracking-wide text-white uppercase transition-colors hover:text-gold-400 ${
									isActive(link.href)
										? "border-b-2 border-gold-500 pb-1 text-gold-400"
										: "pb-1"
								}`}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<Button href="/enroll-today" variant="glow">Start Training</Button>
		</nav>

		<button
			type="button"
			id="mobile-menu-toggle"
			class="inline-flex items-center justify-center rounded p-2 text-white lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Toggle menu"
		>
			<svg
				id="icon-open"
				xmlns="http://www.w3.org/2000/svg"
				class="h-7 w-7"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
			<svg
				id="icon-close"
				xmlns="http://www.w3.org/2000/svg"
				class="hidden h-7 w-7"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<nav
		id="mobile-menu"
		aria-label="Primary mobile"
		class="absolute inset-x-0 top-full hidden max-h-[calc(100vh-5rem)] overflow-y-auto border-t border-gold-500/30 bg-navy-900 shadow-lg lg:hidden"
	>
		<ul class="flex flex-col gap-1 px-4 py-4 sm:px-6">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							class={`block py-2 font-heading text-sm font-bold tracking-wide text-white uppercase ${
								isActive(link.href) ? "text-gold-400" : ""
							}`}
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li class="pt-2">
				<Button
					href="/enroll-today"
					variant="glow"
					class="w-full justify-center"
				>
					Start Training
				</Button>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById("mobile-menu-toggle");
	const menu = document.getElementById("mobile-menu");
	const iconOpen = document.getElementById("icon-open");
	const iconClose = document.getElementById("icon-close");

	toggle?.addEventListener("click", () => {
		const expanded = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!expanded));
		menu?.classList.toggle("hidden");
		iconOpen?.classList.toggle("hidden");
		iconClose?.classList.toggle("hidden");
	});
</script>
