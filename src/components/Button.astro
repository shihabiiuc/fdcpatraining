---
interface Props {
	href: string;
	variant?: "primary" | "outline" | "outline-light" | "outline-gold" | "glow";
	class?: string;
	arrow?: boolean;
	arrowStrokeWidth?: number;
	target?: "_blank";
}

const {
	href,
	variant = "primary",
	class: className = "",
	arrow = false,
	arrowStrokeWidth = 2,
	target,
} = Astro.props;

const variants = {
	primary:
		"font-semibold bg-gold-500 text-navy-900 hover:bg-gold-400 focus-visible:outline-navy-900",
	outline:
		"font-semibold border-2 border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white",
	"outline-light":
		"font-semibold border-2 border-white text-white hover:bg-white hover:text-navy-900",
	"outline-gold":
		"rounded-[5px] font-semibold border-2 border-gold-500 text-white hover:bg-gold-500 hover:text-navy-900",
	glow: "rounded-[7px] font-black text-black bg-[linear-gradient(180deg,#f5c866_0%,#d99a3d_45%,#b9822a_100%)] shadow-[inset_0_1px_0_rgba(255,255,255,0.55),inset_0_-1px_0_rgba(0,0,0,0.25)] hover:brightness-105 focus-visible:outline-navy-900",
};

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<a
	href={href}
	target={target}
	rel={rel}
	class={`inline-flex items-center gap-2 px-6 py-3 font-heading text-sm tracking-wide uppercase transition-colors ${variants[variant]} ${className}`}
>
	<slot />
	{
		arrow && (
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width={arrowStrokeWidth}
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14" />
				<path d="m12 5 7 7-7 7" />
			</svg>
		)
	}
</a>
