---
import { Image } from "astro:assets";
import logoSrc from "../assets/images/logo.png";

interface Props {
	class?: string;
	loading?: "eager" | "lazy";
}

const { class: className = "h-12", loading = "eager" } = Astro.props;
---

<a
	href="/"
	aria-label="FDCPA Training — home"
	class="inline-flex items-center"
>
	<Image
		src={logoSrc}
		alt="FDCPA Training"
		width={400}
		height={160}
		densities={[1, 2]}
		format="webp"
		quality="high"
		loading={loading}
		class={`w-auto ${className}`}
	/>
</a>
