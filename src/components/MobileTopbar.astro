---
const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Course Overview", href: "/course-overview" },
	{ label: "Pricing", href: "/pricing" },
	{ label: "FAQ", href: "/faq" },
	{ label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<div
	class="flex items-stretch justify-between gap-1 bg-[#001230] px-1.5 py-1.5 lg:hidden"
	aria-label="Mobile quick links"
>
	{
		navLinks.map((link) => (
			<a
				href={link.href}
				aria-current={isActive(link.href) ? "page" : undefined}
				class={`flex-1 truncate px-1 py-1.5 text-center text-[11px] font-semibold tracking-tight ${
					isActive(link.href)
						? "border-b-2 border-gold-500 text-gold-400"
						: "border-b-2 border-transparent text-[#f2f2f2]"
				}`}
			>
				{link.label}
			</a>
		))
	}
</div>
