---
interface Props {
	videoSrc: string;
	title: string;
	thumbnail?: string;
	class?: string;
}

const {
	videoSrc,
	title,
	thumbnail = "/video-thumbnail.webp",
	class: className = "",
} = Astro.props;
---

<div
	class={`video-facade relative w-full ${className}`}
	style="aspect-ratio: 16/9;"
	data-video-src={videoSrc}
	data-video-title={title}
>
	<button
		type="button"
		class="video-facade-play group absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center border-0 bg-transparent p-0"
		aria-label={`Play video: ${title}`}
	>
		<img
			src={thumbnail}
			alt=""
			width="600"
			height="338"
			loading="lazy"
			class="absolute inset-0 h-full w-full object-cover"
		/>
		<svg
			viewBox="0 0 75 75"
			class="relative h-14 w-14 shrink-0 drop-shadow-lg transition-transform group-hover:scale-105"
			aria-hidden="true"
		>
			<circle cx="37.5" cy="37.5" r="36.8" fill="#ffffff"></circle>
			<path fill="#00173a" d="M28.9 22.8v30l23.6-15Z"></path>
		</svg>
	</button>
</div>

<script>
	document.querySelectorAll<HTMLElement>(".video-facade").forEach((container) => {
		const button = container.querySelector(".video-facade-play");
		button?.addEventListener(
			"click",
			() => {
				const iframe = document.createElement("iframe");
				iframe.src = container.dataset.videoSrc ?? "";
				iframe.style.cssText =
					"position: absolute; inset: 0; width: 100%; height: 100%; border: none; display: block;";
				iframe.allow =
					"accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;";
				iframe.allowFullscreen = true;
				iframe.title = container.dataset.videoTitle ?? "Video";
				container.replaceChildren(iframe);
			},
			{ once: true },
		);
	});
</script>
