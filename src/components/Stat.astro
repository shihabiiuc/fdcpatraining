---
interface Props {
  value: string;
  unit?: string;
  label: string;
  icon: "calendar" | "team" | "grad-cap" | "check-circle" | "shield";
}

const { value, unit, label, icon } = Astro.props;

const icons: Record<Props["icon"], string> = {
  calendar: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#01172F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days-icon lucide-calendar-days"><path d="M8 2v3"/><path d="M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M8 13h.01"/><path d="M12 13h.01"/><path d="M16 13h.01"/><path d="M8 17h.01"/><path d="M12 17h.01"/><path d="M16 17h.01"/></svg>`,
  team: `<svg viewBox="0 0 24 24" width="68" height="68" aria-hidden="true">
		<circle cx="12" cy="5.6" r="2.3" fill="#01172F"/>
		<rect x="9" y="7.6" width="6" height="5.4" rx="2.4" fill="#01172F"/>
		<circle cx="6.4" cy="9.2" r="3" fill="#01172F"/>
		<rect x="1.6" y="12.2" width="9.6" height="7.6" rx="4" fill="#01172F"/>
		<circle cx="17.6" cy="9.2" r="3" fill="#01172F"/>
		<rect x="12.8" y="12.2" width="9.6" height="7.6" rx="4" fill="#01172F"/>
	</svg>`,
  "grad-cap": `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#01172F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap-icon lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>`,
  "check-circle": `<svg viewBox="0 0 24 24" width="68" height="68" fill="none" aria-hidden="true">
		<circle cx="12" cy="12" r="9" stroke="#01172F" stroke-width="1.8"/>
		<path d="m8 12.4 2.6 2.6L16 9.4" stroke="#01172F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>`,
  shield: `<svg viewBox="0 0 24 24" width="68" height="68" fill="none" aria-hidden="true">
		<path d="M12 3 20 6v6c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V6Z" fill="#01172F"/>
		<path d="m8.3 12.2 2.6 2.6 4.8-5.4" stroke="#D99A3D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>`,
};
---

<div class="flex flex-col items-center gap-2 text-center">
  <div class="flex items-center gap-3">
    <span set:html={icons[icon]} />
    <div class="leading-tight">
      <p class="font-heading text-2xl font-bold text-[#01172F] sm:text-3xl">
        {value}
      </p>
      {
        unit && (
          <p class="font-heading text-xs font-bold tracking-wide text-[#01172F] uppercase sm:text-sm">
            {unit}
          </p>
        )
      }
    </div>
  </div>
  <p class="text-base text-[#01172F]">{label}</p>
</div>
