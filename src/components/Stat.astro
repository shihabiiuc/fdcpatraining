---
interface Props {
	value: string;
	label: string;
	icon: "calendar" | "team" | "grad-cap" | "check-circle" | "shield";
}

const { value, label, icon } = Astro.props;

const icons: Record<Props["icon"], string> = {
	calendar:
		'<path d="M7 3v3M17 3v3M4 9h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"/>',
	team: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14a5 5 0 0 1 5.5 5"/>',
	"grad-cap":
		'<path d="M2 9 12 4l10 5-10 5-10-5Z"/><path d="M6 11.5V17c0 1.4 2.7 3 6 3s6-1.6 6-3v-5.5"/>',
	"check-circle":
		'<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
	shield:
		'<path d="M12 3 20 6v6c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V6Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
};
---

<div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
	<svg
		viewBox="0 0 24 24"
		width="30"
		height="30"
		fill="none"
		stroke="#101F3C"
		stroke-width="1.75"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		set:html={icons[icon]}
	/>
	<p class="font-heading text-2xl font-bold text-navy-900 sm:text-3xl">
		{value}
	</p>
	<p class="text-sm text-navy-900/80">{label}</p>
</div>
