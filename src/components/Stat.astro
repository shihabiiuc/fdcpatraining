---
interface Props {
  value: string;
  unit?: string;
  label: string;
  icon: "calendar" | "team" | "grad-cap" | "check-circle" | "shield";
  uppercaseLabel?: boolean;
}

const { value, unit, label, icon, uppercaseLabel = false } = Astro.props;

const iconFiles: Record<Props["icon"], string> = {
  calendar: "calendar",
  team: "users",
  "grad-cap": "graduation",
  "check-circle": "checkmark",
  shield: "shield-check",
};
---

<div class="flex flex-col items-center gap-2 text-center">
  <div class="flex items-center gap-3">
    <img
      src={`/icons/home/${iconFiles[icon]}.svg`}
      alt=""
      width="56"
      height="56"
      class="h-14 w-14 shrink-0"
    />
    <div class="leading-tight">
      <p class="font-heading text-3xl font-extrabold text-[#01172F] sm:text-4xl">
        {value}
      </p>
      {
        unit && (
          <p class="font-heading text-sm font-bold tracking-wide text-[#01172F] uppercase sm:text-base">
            {unit}
          </p>
        )
      }
    </div>
  </div>
  <p
    class:list={[
      "text-[#01172F]",
      uppercaseLabel
        ? "text-sm uppercase font-semibold"
        : "text-base",
    ]}
  >
    {label}
  </p>
</div>
