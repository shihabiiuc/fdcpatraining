---
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const year = new Date().getFullYear();

const bottomLinks = [
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Use", href: "/terms-of-use" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="border-t border-gold-500/40 bg-navy-900 text-white">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 py-10 text-center sm:px-6 md:grid-cols-4 md:divide-x md:divide-gold-500/30 md:text-left lg:px-8"
  >
    <div class="flex items-center justify-center md:justify-start">
      <Logo class="h-16" />
    </div>

    <div class="flex items-center justify-center md:justify-start md:pl-6">
      <p class="text-sm text-white/80">
        Practical training that builds knowledge, strengthens judgment, and
        drives compliance.
      </p>
    </div>

    <div
      class="flex flex-col items-center justify-center gap-3 md:items-start md:pl-6"
    >
      <Button href="/enroll-today" variant="glow" arrow
        >Start Training Today</Button
      >
      <a
        href="/"
        class="text-sm font-bold tracking-wide text-gold-400 hover:text-gold-300"
      >
        FDCPATraining.com
      </a>
    </div>

    <div class="flex items-center justify-center md:justify-start md:pl-6">
      <a
        href="https://www.linkedin.com/in/gayle-w-bb013a2"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 text-sm text-white hover:text-gold-400"
      >
        <span
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded bg-white text-navy-900"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"
            ></path>
          </svg>
        </span>
        <span class="text-left">
          View Professional Background<br />
          on LinkedIn <span aria-hidden="true">&rarr;</span>
        </span>
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-4 py-4 text-xs text-white/70 sm:flex-row sm:justify-between sm:px-6 lg:px-8"
    >
      <p>&copy; 1995 - {year} FDCPA Training. All Rights Reserved.</p>
      <ul class="flex items-center gap-2">
        {
          bottomLinks.map((link, index) => (
            <li class="flex items-center gap-2">
              <a href={link.href} class="hover:text-gold-400">
                {link.label}
              </a>
              {index < bottomLinks.length - 1 && (
                <span aria-hidden="true">|</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
