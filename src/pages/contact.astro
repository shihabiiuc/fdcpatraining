---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroPhoto from "../assets/images/hero_contact_changed.jpg";
import siteIcon from "../assets/images/site_icon.png";

const heroChecklist = [
  "Quick responses",
  "Expert support",
  "Personalized assistance",
];

const contactMethods = [
  {
    icon: "envelope",
    title: "Email",
    highlight: {
      text: "info@fdcpatraining.com",
      href: "mailto:info@fdcpatraining.com",
    },
    lines: ["We typically respond within one business day."],
  },
  {
    icon: "phone",
    title: "Phone",
    highlight: { text: "512-522-8005", href: "tel:+15125228005" },
    lines: ["Monday – Friday", "9:00 AM – 5:00 PM CT"],
  },
  {
    icon: "users",
    title: "For Organizations",
    lines: [
      "Volume pricing, invoicing, and team enrollment.",
      "Contact us to discuss your training needs.",
    ],
  },
  {
    icon: "chat",
    title: "Response Time",
    lines: [
      "We are committed to providing timely, helpful responses to all inquiries.",
    ],
  },
];

const helpItems = [
  "Course content and curriculum questions",
  "Enrollment and pricing information",
  "Organizational and team training",
  "Volume pricing and invoicing",
  "Technical support and access",
  "Certificates and reporting",
  "Any other questions you may have",
];

const inputClasses =
  "w-full rounded-[6px] border border-navy-900/15 bg-white px-4 py-3 text-sm text-navy-900 placeholder:text-navy-900/40 focus:border-gold-500 focus:outline-none";
---

<Layout
  title="Contact Us | FDCPA Training"
  description="Contact FDCPA Training for questions about course content, enrollment, pricing, and organizational training needs. We typically respond within one business day."
>
  <!-- Hero -->
  <section class="bg-white mb-[30px]">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-8 lg:px-8"
    >
      <div class="py-[30px]">
        <h1
          class="font-heading text-4xl leading-tight font-black tracking-tight text-navy-900 uppercase sm:text-[45px]"
        >
          Contact Us
        </h1>
        <span class="mt-3 block h-0.5 w-16 bg-gold-500" aria-hidden="true"
        ></span>
        <p class="mt-4 max-w-lg text-navy-900/80">
          We&rsquo;re here to help with your FDCPA training questions,
          enrollment, and organizational training needs.
        </p>

        <ul
          class="mt-6 flex flex-wrap items-center gap-y-3 sm:divide-x sm:divide-navy-900/20"
        >
          {
            heroChecklist.map((item) => (
              <li class="flex items-center gap-2 pr-5 sm:px-5 sm:first:pl-0">
                <img
                  src="/icons/contact/checkmark-circle.svg"
                  alt=""
                  width="20"
                  height="20"
                  class="h-5 w-5 shrink-0"
                />
                <span class="text-sm font-semibold text-navy-900">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative h-64 sm:h-80 lg:h-full">
        <Image
          src={heroPhoto}
          alt="A laptop and a small succulent plant on a desk, ready for an FDCPA training conversation"
          width={848}
          height={477}
          class="h-full w-full rounded-[6px] object-cover lg:rounded-none lg:[-webkit-mask-image:linear-gradient(to_right,transparent,black_18%)] lg:[mask-image:linear-gradient(to_right,transparent,black_18%)]"
        />
      </div>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-[30px] sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          contactMethods.map((method) => (
            <div class="flex flex-col items-center gap-3 rounded-[6px] border border-navy-900/10 bg-white px-6 py-8 text-center shadow-sm">
              <img
                src={`/icons/contact/${method.icon}.svg`}
                alt=""
                width="64"
                height="64"
                class="h-16 w-16"
              />
              <p class="font-heading text-lg font-bold tracking-wide text-navy-900 uppercase">
                {method.title}
              </p>
              <span class="h-px w-8 bg-gold-500" aria-hidden="true" />
              <div class="space-y-1">
                {method.highlight && (
                  <a
                    href={method.highlight.href}
                    class="block font-heading font-bold text-navy-900 hover:text-gold-600"
                  >
                    {method.highlight.text}
                  </a>
                )}
                {method.lines.map((line) => (
                  <p class="text-sm text-navy-900/80">{line}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Send Us a Message / We Can Help With -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-[30px] sm:px-6 lg:px-8">
      <div
        class="grid gap-10 rounded-[8px] border border-navy-900/10 bg-surface px-6 py-8 sm:px-10 lg:grid-cols-2 lg:gap-0 lg:divide-x lg:divide-navy-900/15"
      >
        <!-- Send Us a Message -->
        <div class="lg:pr-10">
          <div class="flex items-center gap-4">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold-500"
            >
              <img
                src="/icons/contact/edit.svg"
                alt=""
                width="24"
                height="24"
                class="h-6 w-6"
              />
            </span>
            <h2
              class="font-heading text-xl font-bold tracking-wide text-navy-900 uppercase sm:text-2xl"
            >
              Send Us a Message
            </h2>
          </div>
          <p class="mt-2 text-navy-900/70">
            Fill out the form below and we&rsquo;ll get back to you as soon as
            possible.
          </p>

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="mt-6 space-y-4"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Don&rsquo;t fill this out if you&rsquo;re human:
                <input name="bot-field" />
              </label>
            </p>

            <div class="grid gap-4 sm:grid-cols-2">
              <input
                type="text"
                name="first-name"
                placeholder="First Name"
                autocomplete="given-name"
                required
                class={inputClasses}
              />
              <input
                type="text"
                name="last-name"
                placeholder="Last Name"
                autocomplete="family-name"
                required
                class={inputClasses}
              />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <input
                type="email"
                name="email"
                placeholder="Email Address"
                autocomplete="email"
                required
                class={inputClasses}
              />
              <input
                type="tel"
                name="phone"
                placeholder="Phone Number"
                autocomplete="tel"
                class={inputClasses}
              />
            </div>

            <div class="relative">
              <select
                name="organization"
                class={`${inputClasses} appearance-none pr-10 text-navy-900/70`}
              >
                <option value="" selected>Organization (if applicable)</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
              </select>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-navy-900/50"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>

            <textarea
              name="message"
              placeholder="How can we help you?"
              rows="5"
              required
              class={`${inputClasses} resize-none`}></textarea>

            <button
              type="submit"
              class="inline-flex w-full items-center justify-center gap-3 rounded-[6px] border-2 border-gold-500 bg-navy-900 px-6 py-4 font-heading text-sm font-extrabold tracking-wide text-white uppercase transition-colors hover:bg-navy-800"
            >
              Send Message
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#E19525"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>

            <p class="flex items-center gap-2 text-xs text-navy-900/60">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0"
                aria-hidden="true"
              >
                <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              Your information is secure and will never be shared.
            </p>
          </form>
        </div>

        <!-- We Can Help With -->
        <div class="lg:pl-10">
          <div class="flex items-center gap-4">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold-500"
            >
              <img
                src="/icons/contact/info.svg"
                alt=""
                width="24"
                height="24"
                class="h-6 w-6"
              />
            </span>
            <h2
              class="font-heading text-xl font-bold tracking-wide text-navy-900 uppercase sm:text-2xl"
            >
              We Can Help With:
            </h2>
          </div>

          <ul class="mt-6 space-y-3">
            {
              helpItems.map((item) => (
                <li class="flex items-start gap-3">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#E19525"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 shrink-0"
                    aria-hidden="true"
                  >
                    <path d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-navy-900/90">{item}</span>
                </li>
              ))
            }
          </ul>

          <span class="mt-8 block h-px w-full bg-gold-500" aria-hidden="true"
          ></span>

          <div class="mt-8 flex items-start gap-4">
            <Image
              src={siteIcon}
              alt=""
              width={56}
              height={75}
              class="w-14 h-auto shrink-0"
            />
            <div>
              <h3
                class="font-heading text-lg font-bold tracking-wide text-navy-900 uppercase"
              >
                Our Mission
              </h3>
              <p class="mt-1 text-navy-900/80">
                To provide practical, comprehensive FDCPA training that helps
                collection professionals make lawful decisions, apply ethical
                practices, and achieve stronger outcomes.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ready to Get Started CTA -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-[30px] sm:px-6 lg:px-8">
      <div
        class="flex flex-col gap-6 rounded-[8px] bg-navy-900 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/contact/shield-check.svg"
            alt=""
            width="75"
            height="75"
            class="h-[75px] w-[75px] shrink-0"
          />
          <div>
            <p
              class="font-heading text-[1.7rem] font-bold tracking-wide text-[#e69c24] uppercase"
            >
              Ready to Get Started?
            </p>
            <p class="mt-1 max-w-[560px] text-white/90">
              Join over 1,200 collection professionals across 55 teams who have
              completed the course with a 97.3% pass rate.
            </p>
          </div>
        </div>

        <a
          href="/course-overview"
          class="inline-flex shrink-0 items-center gap-2 rounded-[5px] bg-gold-500 px-6 py-3 font-heading text-[1rem] font-extrabold tracking-wide text-[#011a47] uppercase transition-colors hover:bg-gold-400 sm:text-[1.2rem]"
        >
          View Course Overview
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  #main-content {
    --color-gold-400: #e19525;
    --color-gold-500: #e19525;
    --color-gold-600: #e19525;
  }
</style>
