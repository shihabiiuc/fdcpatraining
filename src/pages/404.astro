---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import VideoEmbed from "../components/VideoEmbed.astro";

const posterUrl = new URL("/video-thumbnail.webp", Astro.site);
const videoSrc =
  "https://player.mux.com/vdsytbs9G02qc01oqRLHb5OgxwLEMke9GCPFWO3LIbEZ4?metadata-video-title=Course+Overview&video-title=Course+Overview&accent-color=%23ffffff&primary-color=%23e69c24&poster=" +
  encodeURIComponent(posterUrl.toString());
---

<Layout
  title="Page Not Found | FDCPA Training"
  description="The page you're looking for can't be found. Explore FDCPA Training's course overview instead."
>
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-24">
      <h1
        class="mt-[30px] font-heading text-4xl leading-tight font-black tracking-tight text-navy-900 uppercase sm:text-[45px]"
      >
        404 - Page Not Found
      </h1>
      <p class="mt-3 text-navy-900/80">
        Sorry, the page you&rsquo;re looking for doesn&rsquo;t exist.
      </p>
      <span class="mx-auto mt-3 block h-0.5 w-16 bg-gold-500" aria-hidden="true"></span>

      <h2
        class="mt-6 font-heading text-3xl font-black tracking-tight text-[#011a47] uppercase sm:text-4xl"
      >
        Practical Training for Real Collection Decisions
      </h2>
      <p class="mt-4 text-navy-900/80">
        We couldn&rsquo;t find the page you were looking for, but here&rsquo;s
        a quick look at what FDCPA Training is all about.
      </p>

      <div
        class="mx-auto mt-10 max-w-xl overflow-hidden rounded-[5px] border-2 border-gold-500/40"
      >
        <VideoEmbed videoSrc={videoSrc} title="Course Overview" />
      </div>

      <div class="mt-10 mb-[30px] flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/course-overview" variant="glow" arrow>
          View Course Overview
        </Button>
        <Button href="/" variant="outline">Back to Home</Button>
      </div>
    </div>
  </section>
</Layout>
