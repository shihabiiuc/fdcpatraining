          <span class="h-0.5 w-8 bg-red-500"></span>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6">
        {
          whoItems.map((item) => (
            <div class="flex flex-col items-center gap-3 text-center">
              <span set:html={whoIcons[item.icon]} />
              <p class="font-heading text-sm font-semibold tracking-wide text-navy-900 uppercase">
