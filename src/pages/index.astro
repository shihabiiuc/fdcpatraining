        <div class="mx-auto mt-2 mb-8 flex items-center justify-center gap-2">
          <span class="h-0.5 w-8 bg-red-500"></span>
          <span class="text-xl text-red-500" aria-hidden="true">&#9733;</span>
          <span class="h-0.5 w-8 bg-red-500"></span>
        </div>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 sm:divide-x sm:divide-navy-900/15">
        {
          whyItems.map((item, i) => (
            <div class={`flex items-start gap-4 ${i === 0 ? "" : "sm:pl-8"}`}>
              <span set:html={whyIcons[item.icon]} />
              <div>
                <p class="font-heading text-sm font-bold tracking-wide text-[#01172F] uppercase">
                  {item.title}
                </p>
                <p class="mt-1 text-sm text-[#01172F]">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Who This Training Is For -->
  <section class="bg-white">
