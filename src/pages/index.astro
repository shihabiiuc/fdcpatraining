<Layout
  title="FDCPA Training | FDCPA & Regulation F Compliance Training"
  description="Comprehensive, scenario-based FDCPA and CFPB Regulation F training that equips collection professionals to make lawful, defensible decisions while reducing compliance and litigation risk."
>
  <!-- Hero -->
  <section class="bg-navy-900 text-white">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[45fr_29fr_26fr] lg:items-center lg:px-8 lg:py-20"
    >
      <div class="text-center lg:text-left">
        <h1 class="font-heading text-4xl leading-tight font-bold sm:text-5xl">
          Practical Training.<br />
          Better Decisions.<br />
          <span class="text-gold-400">Stronger Compliance.</span>
        </h1>
        <div
          class="my-5 flex items-center justify-center gap-3 lg:justify-start"
        >
          <span class="h-0.5 w-28 bg-red-500"></span>
          <span class="text-red-500" aria-hidden="true">&#9733;</span>
          <span class="h-0.5 w-28 bg-red-500"></span>
        </div>
        <p class="mx-auto max-w-md text-white/85 lg:mx-0">
          Comprehensive, scenario-based FDCPA and CFPB Regulation F training
          that equips collection professionals to make lawful, defensible
          decisions while reducing compliance and litigation risk.
        </p>
      </div>

      <div>
        <Image
          src={heroPhoto}
          alt="A gavel resting on a bound copy of the FDCPA"
          width={320}
          height={320}
          class="mx-auto aspect-square h-auto w-full max-w-md rounded-full border-4 border-white object-cover lg:mx-0"
        />
      </div>

      <div class="text-center lg:text-left">
        <Image
          src={logoText}
          alt="FDCPA Training — Knowledge. Judgment. Compliance."
          width={400}
          height={227}
          class="mx-auto w-full max-w-sm lg:mx-0"
        />
        <span
          class="my-4 block h-[3px] w-full"
          style="background-color: #ce8d0d"></span>
        <p class="text-center text-[2rem] leading-tight text-white/85">
          15 U.S.C. &sect;1692<br />
          &amp; 12 C.F.R. Part 1006
        </p>
        <span
          class="my-4 block h-[3px] w-full"
          style="background-color: #ce8d0d"></span>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-[#dbdbdb] bg-white">
    <div
      class="mx-auto grid max-w-7xl grid-cols-2 gap-x-8 gap-y-10 px-4 py-10 sm:px-6 md:grid-cols-3 lg:grid-cols-5 lg:gap-x-0 lg:divide-x lg:divide-navy-900/15 lg:px-8"
    >
      <Stat
        icon="calendar"
        value="20+"
        unit="YEARS"
        label="Training Collection Professionals"
      />
      <div class="lg:pl-8">
        <Stat icon="team" value="55+" label="Risk Management Teams Served" />
      </div>
      <div class="lg:pl-8">
        <Stat
          icon="grad-cap"
          value="1,200+"
          label="Trainees Successfully Completed"
        />
      </div>
      <div class="lg:pl-8">
        <Stat
          icon="check-circle"
          value="97.3%"
          label="Average Course Pass Rate"
        />
      </div>
      <div
        class="col-span-2 flex flex-col items-center gap-2 text-center md:col-span-1 lg:pl-8"
      >
        <svg
          viewBox="0 0 24 24"
          width="68"
          height="68"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M12 3 20 6v6c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V6Z"
            fill="#01172F"></path>
          <path
            d="m8.3 12.2 2.6 2.6 4.8-5.4"
            stroke="#D99A3D"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <p class="text-sm font-semibold text-[#01172F] uppercase tracking-wide">
          Practical Training.<br />Real-World Scenarios.
        </p>
        <p class="text-sm font-bold text-gold-600 uppercase tracking-wide">
          Better Compliance.
        </p>
      </div>
    </div>
  </section>

  <!-- Video + What You'll Learn -->
  <section class="border-b border-[#dbdbdb] bg-white">
    <div
      class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 pt-[30px] pb-[30px] sm:px-6 lg:grid-cols-2 lg:px-8"
    >
      <div
        class="self-start overflow-hidden rounded-[5px] border-2 border-gold-500/40"
      >
        <iframe
          src="https://player.mux.com/nMsf4hAGiih2x00Gt2wvDFAc7a016u3EAGGd4qBzaJiEg?metadata-video-title=FDCPA+Training+Overview&video-title=FDCPA+Training+Overview"
          style="width: 100%; border: none; aspect-ratio: 16/9; display: block;"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
          allowfullscreen
          title="FDCPA Training Overview"></iframe>
      </div>

      <div>
        <h2 class="font-heading text-3xl font-bold text-navy-900">
          What You&rsquo;ll Learn
        </h2>
        <p class="mt-2 text-navy-900">
          A complete learning experience covering all key requirements.
        </p>
        <ul class="mt-5 space-y-3">
          {
            learnItems.map((item) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold-400 text-white"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="12"
                    height="12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m5 12 5 5 9-9" />
                  </svg>
                </span>
                <span class="text-navy-900">{item}</span>
              </li>
            ))
          }
        </ul>
        <a
