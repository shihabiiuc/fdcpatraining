  <!-- Author bio -->
  <section
    class="relative overflow-hidden bg-navy-900 bg-cover bg-bottom bg-no-repeat text-white"
    style="background-image: url('/bg.svg');"
  >
    <div
      class="relative mx-auto flex max-w-7xl flex-col gap-10 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:px-8"
    >
      <div
        class="flex flex-col items-center gap-6 text-center sm:flex-row sm:items-center sm:text-left lg:flex-1"
      >
        <Image
          src={gayleWolfe}
          alt="Gayle Wolfe, Course Author & SME"
          width={300}
          height={300}
          class="h-[220px] w-[220px] shrink-0 rounded-full border-4 border-gold-500 object-cover sm:h-[300px] sm:w-[300px]"
        />
        <div>
          <p class="font-heading text-[2rem] leading-tight font-bold text-gold-400">
            Gayle Wolfe, Course Author &amp; SME
